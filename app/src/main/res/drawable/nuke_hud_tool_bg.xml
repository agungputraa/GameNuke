<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#123C27"/><stroke android:width="1dp" android:color="#49F67E"/><corners android:radius="5dp"/>
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#123C27" android:endColor="#08130E"/>
            <stroke android:width="1dp" android:color="#49F67E"/><corners android:radius="5dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#050D0A"/><stroke android:width="1dp" android:color="#163525"/><corners android:radius="5dp"/>
        </shape>
    </item>
</selector>
